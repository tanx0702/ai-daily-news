# ========== LLM 配置（必填）==========
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL=agnes-2.0-flash
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# ========== 微信公众号配置（必填）==========
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
# Token：公众号后台「服务器配置」中设置的 Token，需两边一致
WECHAT_TOKEN=your_custom_token_here
# 仅本地临时调试可设为 1；生产必须保持 0，缺少 WECHAT_TOKEN 时会拒绝微信请求
ALLOW_INSECURE_WECHAT_TOKEN=0
# 公众号草稿顶部展示：避免机器人感标题和英文署名
WECHAT_DRAFT_TITLE_PREFIX=今日要闻
WECHAT_DRAFT_AUTHOR=要闻编辑室

# ========== 域名配置 ==========
DOMAIN=tankex.xyz
# 日报页面完整 URL（可选，默认 https://{DOMAIN}）
PAGES_URL=https://tankex.xyz

# ========== 日报配置（可选）==========
DAILY_TOP_N=10
DAILY_RSS_TIMEOUT=30
DAILY_LLM_TIMEOUT=30

# ========== News Freshness（Phase 1 新增）==========
# 新闻时间窗口（小时）。默认 36：只保留最近 36 小时内的新闻，避免旧新闻混入。
DAILY_NEWS_HOURS=36
# 是否允许没有发布时间的新闻进入日报（默认: 0）。
# 强烈建议保持 0。支持 1/true/yes/on 开启，0/false/no/off 关闭。
DAILY_ALLOW_UNDATED=0

# ========== Hot Signal Collectors（Phase 2-3 新增）==========
# 所有 ENABLE_* 变量接受以下布尔值（大小写不敏感）：
#   开启: 1 / true / yes / on
#   关闭: 0 / false / no / off
# 不设置则使用括号内的默认值。

# 是否启用 Hacker News 采集器（默认: 1）
# 用于发现技术社区正在讨论的 AI 热点，无需 API Token。
ENABLE_HN_COLLECTOR=1
# HN 明细抓取总超时秒数，避免单日任务被部分慢请求拖住过久。
HN_DETAILS_TIMEOUT=90
# 是否启用 GitHub 采集器（默认: 1）
# 用于发现热门 AI 开源项目。建议配置 GITHUB_TOKEN 以避免限流。
ENABLE_GITHUB_COLLECTOR=true
# 是否启用 Hugging Face 采集器（默认: 1）
# 用于发现近期热门模型。HF_TOKEN 可选，未配置也能正常使用。
ENABLE_HF_COLLECTOR=yes
# 是否启用 arXiv 采集器（默认: 1）
# 用于发现 24-48 小时内的 AI 论文热点，最终日报中默认最多 2 条。
ENABLE_ARXIV_COLLECTOR=on

# ========== Optional API Tokens（推荐但不强制）==========
# GitHub Personal Access Token，可选但推荐配置。
# 未配置时 GitHub 采集器也能运行，但未认证请求限流较低（10 次/min），
# 配置后限流提升到 30 次/min。不会导致主流程失败。
GITHUB_TOKEN=
# Hugging Face Token，可选。
# 公开模型无需 Token 也能访问；配置后可提升稳定性并访问更多 Hub API。
HF_TOKEN=

# ========== LLM Quality Gate（发布前质检，可选）==========
# 是否启用 LLM 发布前质量门禁。默认开启。
# 支持 1/true/yes/on 开启，0/false/no/off 关闭。
ENABLE_LLM_QUALITY_GATE=1

# 严格模式。默认关闭。
# 0：发现风险后尽量自动修正，并继续生成草稿。
# 1：发布安全过滤后仍存在 high risk 或候选不足时，生成 debug/HTML 但跳过微信公众号草稿发布。
QUALITY_GATE_STRICT=0

# 是否启用发布安全过滤。默认开启。
# 开启后会多采集 DAILY_SAFETY_RESERVE_N 条备用候选，质检 high risk 单条会被移除并用后备候选回填。
ENABLE_PUBLISH_SAFETY_FILTER=1

# 发布安全过滤的备用候选数量。默认 6，即 DAILY_TOP_N=10 时先采集 16 条，最终仍发布 10 条。
DAILY_SAFETY_RESERVE_N=6

# 质检 LLM 超时秒数。默认沿用 DAILY_LLM_TIMEOUT，也可以单独设置。
QUALITY_GATE_TIMEOUT=30

# ========== WeChat Visual Quality（正文视觉质量，可选）==========
# 是否启用正文原文图抓取。默认开启。
# 开启后会尝试抓取原文 og:image / twitter:image。
# 没有原文图时不会生成占位图，而是渲染为纯文字卡片。
ENABLE_ARTICLE_IMAGE_FETCH=1

# 是否启用 AI 生图封面。默认开启。
# 封面策略：可信原文图优先；没有可信原文图时使用 AI 生图；AI 失败时使用极简本地无字背景。
ENABLE_AI_COVER_GENERATION=1

# AI 图疑似生成了错误文字/Logo 时，是否强制使用极简本地无字背景。
FORCE_LOCAL_COVER_ON_BAD_IMAGE=1

# 正文图片抓取超时秒数。
ARTICLE_IMAGE_TIMEOUT=8

# 无原文图新闻的卡片样式。
# compact_text 表示紧凑纯文字卡片；不要使用 placeholder image。
NO_IMAGE_CARD_STYLE=compact_text

# ========== GitHub 配置（仅用于 footer 链接，可选）==========
GITHUB_USERNAME=tanx0702
GITHUB_REPO=ai-daily-news
