# 文本 LLM（必填）
LLM_API_KEY=your_text_llm_api_key
LLM_MODEL=your_text_model
LLM_API_BASE=https://your-text-provider.example/v1

# 日报封面图生成（可选）
# 仅在希望使用本地封面降级方案时，才留空 IMAGE_API_KEY。
IMAGE_API_KEY=your_image_api_key
IMAGE_MODEL=your_image_model
IMAGE_API_BASE=https://your-image-provider.example/v1

# 微信公众号（创建草稿必填）
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
WECHAT_TOKEN=your_custom_token_here

# 对外日报页面
DOMAIN=example.com
PAGES_URL=https://example.com

# 可选调优项见 .env.advanced.example。
# 仅将需要的配置复制到此 .env 文件中。
