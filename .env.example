# ========== LLM 配置（必填）==========
AGNES_API_KEY=your_agnes_api_key
AGNES_MODEL=agnes-2.0-flash
AGNES_API_BASE=https://apihub.agnes-ai.com/v1

# ========== 微信公众号配置（必填）==========
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
# Token：公众号后台「服务器配置」中设置的 Token，需两边一致
WECHAT_TOKEN=your_custom_token_here

# ========== 域名配置 ==========
DOMAIN=tankex.xyz
# 日报页面完整 URL（可选，默认 https://{DOMAIN}）
PAGES_URL=https://tankex.xyz

# ========== 日报配置（可选）==========
DAILY_TOP_N=10
DAILY_RSS_TIMEOUT=30
DAILY_LLM_TIMEOUT=30

# ========== News Freshness（Phase 1 新增）==========
# 新闻时间窗口（小时）。默认 36：只保留最近 36 小时内的新闻，避免旧新闻混入。
DAILY_NEWS_HOURS=36
# 是否允许没有发布时间的新闻进入日报（默认: 0）。
# 强烈建议保持 0。支持 1/true/yes/on 开启，0/false/no/off 关闭。
DAILY_ALLOW_UNDATED=0

# ========== Hot Signal Collectors（Phase 2-3 新增）==========
# 所有 ENABLE_* 变量接受以下布尔值（大小写不敏感）：
#   开启: 1 / true / yes / on
#   关闭: 0 / false / no / off
# 不设置则使用括号内的默认值。

# 是否启用 Hacker News 采集器（默认: 1）
# 用于发现技术社区正在讨论的 AI 热点，无需 API Token。
ENABLE_HN_COLLECTOR=1
# 是否启用 GitHub 采集器（默认: 1）
# 用于发现热门 AI 开源项目。建议配置 GITHUB_TOKEN 以避免限流。
ENABLE_GITHUB_COLLECTOR=true
# 是否启用 Hugging Face 采集器（默认: 1）
# 用于发现近期热门模型。HF_TOKEN 可选，未配置也能正常使用。
ENABLE_HF_COLLECTOR=yes
# 是否启用 arXiv 采集器（默认: 1）
# 用于发现 24-48 小时内的 AI 论文热点，最终日报中默认最多 2 条。
ENABLE_ARXIV_COLLECTOR=on

# ========== Optional API Tokens（推荐但不强制）==========
# GitHub Personal Access Token，可选但推荐配置。
# 未配置时 GitHub 采集器也能运行，但未认证请求限流较低（10 次/min），
# 配置后限流提升到 30 次/min。不会导致主流程失败。
GITHUB_TOKEN=
# Hugging Face Token，可选。
# 公开模型无需 Token 也能访问；配置后可提升稳定性并访问更多 Hub API。
HF_TOKEN=

# ========== GitHub 配置（仅用于 footer 链接，可选）==========
GITHUB_USERNAME=tanx0702
GITHUB_REPO=ai-daily-news
