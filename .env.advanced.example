# Optional configuration reference
#
# Do not copy this file over .env. All variables below are comments so they
# cannot change a deployment by accident. Copy only the settings you need into
# .env, then recreate the Docker containers.
#
# LLM_* and IMAGE_* are the preferred names. Existing deployments may still
# use AGNES_* or OPENAI_* compatibility aliases, but new deployments should not.

# Dedicated quality-review model (unset values inherit the matching LLM_* value)
# QUALITY_LLM_API_KEY=
# QUALITY_LLM_MODEL=
# QUALITY_LLM_API_BASE=

# WeChat draft presentation and local callback debugging
# ALLOW_INSECURE_WECHAT_TOKEN=0
# WECHAT_DRAFT_TITLE_PREFIX=今日要闻
# WECHAT_DRAFT_AUTHOR=要闻编辑室
# WECHAT_USE_AI_TEMPLATE=0
# NEWS_DATA_FILE=/app/docs/latest.json
# PORT=5000

# Daily selection and scheduling (defaults shown)
# APP_TIMEZONE=Asia/Shanghai
# DAILY_TOP_N=10
# DAILY_CANDIDATE_POOL_N=30
# DAILY_MAX_ITEMS_PER_SOURCE=2
# DAILY_MAX_ITEMS_PER_TOPIC=2
# DAILY_MIN_PRIMARY_OR_RESEARCH=2
# DAILY_RSS_TIMEOUT=30
# DAILY_LLM_TIMEOUT=15
# DAILY_NEWS_HOURS=36
# DAILY_ALLOW_UNDATED=0
# DAILY_RUN_LOCK_PATH=docs/.daily_run.lock
# DAILY_RUN_LOCK_TTL_SECONDS=21600

# Additional collectors and optional API tokens
# ENABLE_HN_COLLECTOR=1
# HN_DETAILS_TIMEOUT=90
# ENABLE_GITHUB_COLLECTOR=1
# ENABLE_HF_COLLECTOR=1
# ENABLE_ARXIV_COLLECTOR=1
# GITHUB_TOKEN=
# HF_TOKEN=

# Evidence quality and publish filtering
# ENABLE_LLM_QUALITY_GATE=1
# QUALITY_GATE_STRICT=0
# ENABLE_PUBLISH_SAFETY_FILTER=1
# DAILY_SAFETY_RESERVE_N=6
# QUALITY_GATE_TIMEOUT=15
# QUALITY_GATE_MAX_TOKENS=4000

# Article media and cover generation
# ENABLE_ARTICLE_IMAGE_FETCH=1
# ARTICLE_IMAGE_TIMEOUT=8
# ENABLE_SAFE_COVER=1
# ENABLE_AI_COVER_GENERATION=1
# FORCE_LOCAL_COVER_ON_BAD_IMAGE=1
# AI_COVER_MAX_RETRIES=5
# IMAGE_GENERATION_TIMEOUT=30
# NO_IMAGE_CARD_STYLE=compact_text

# Local and CI dry runs
# SKIP_WECHAT_DRAFT=0
# LOG_DIR=logs

# Footer metadata
# GITHUB_USERNAME=tanx0702
# GITHUB_REPO=tanx0702/ai-daily-news
