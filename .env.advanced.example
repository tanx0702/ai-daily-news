# 可选配置参考
#
# 不要用此文件覆盖 .env。下面的变量均已注释，不会意外改变当前部署。
# 仅将需要的配置复制到 .env，然后重新创建 Docker 容器。
#
# 推荐使用 LLM_* 和 IMAGE_*。旧部署仍兼容 AGNES_*、OPENAI_* 别名，
# 但新部署不应继续使用这些别名。
# 布尔值使用 1（开启）或 0（关闭）。未复制到 .env 时采用程序默认值。

# 独立的质量审核模型：用于发布前核查标题、摘要是否超出原文证据。
# 仅当想让质检使用不同于摘要的模型、密钥或服务商时才填写；留空会继承 LLM_*。
# QUALITY_LLM_API_KEY=
# QUALITY_LLM_MODEL=
# QUALITY_LLM_API_BASE=

# 仅本地调试：当 WECHAT_TOKEN 未配置时跳过微信回调签名验证。
# 生产服务器必须保持 0，否则任何请求都可能伪造微信回调。
# ALLOW_INSECURE_WECHAT_TOKEN=0

# 微信草稿标题前缀，实际标题格式为“前缀｜月日”。仅需更换栏目名称时修改。
# WECHAT_DRAFT_TITLE_PREFIX=今日要闻

# 微信草稿的作者署名。仅需更换公众号展示署名时修改。
# WECHAT_DRAFT_AUTHOR=要闻编辑室

# 是否让 LLM 重写微信公众号正文 HTML；0 使用稳定的内置模板，1 才启用 AI 模板。
# 正常生产建议保持 0，只有需要尝试不同排版且可接受不稳定输出时才设为 1。
# WECHAT_USE_AI_TEMPLATE=0

# Flask 微信回调读取的 latest.json 路径。Docker 默认挂载路径正确，通常不需要修改。
# NEWS_DATA_FILE=/app/docs/latest.json

# 仅直接执行“python app.py”时使用的 Flask 端口；Docker 的 Gunicorn 不读取此项。
# PORT=5000

# 日报日期和“今天”判定所用时区。服务器不在中国时仍应保持 Asia/Shanghai。
# APP_TIMEZONE=Asia/Shanghai

# 每天最终入选并展示的新闻数量。增加会提高阅读长度和 LLM 调用量。
# DAILY_TOP_N=10

# 选题阶段保留的候选池总量，包含正式条目和质检替补；必须不小于 DAILY_TOP_N。
# 增大可提升多样性和回填空间，但会增加摘要生成时间与成本。
# DAILY_CANDIDATE_POOL_N=30

# 同一来源在正式日报中优先最多出现几条，防止单一网站主导内容。
# DAILY_MAX_ITEMS_PER_SOURCE=2

# 同一主题在正式日报中优先最多出现几条，防止同一事件或赛道重复出现。
# DAILY_MAX_ITEMS_PER_TOPIC=2

# 正式日报中优先保留的官方或研究来源最低条数，提升一手信息比例。
# DAILY_MIN_PRIMARY_OR_RESEARCH=2

# 单个 RSS 源或采集请求的超时秒数。网络慢时可增大；过大将拖慢整次任务。
# DAILY_RSS_TIMEOUT=30

# 文本 LLM 的单次摘要请求超时秒数。模型响应较慢时可增大；超时会降级保留原文信息。
# DAILY_LLM_TIMEOUT=15

# 新闻发布时间的回溯窗口（小时）。增大可补足新闻较少的日子，但会降低“当天”的新鲜度。
# DAILY_NEWS_HOURS=36

# 是否接纳没有发布日期的条目；0 会过滤，1 可提高数量但可能混入旧内容。
# DAILY_ALLOW_UNDATED=0

# 防止两个日报任务并发执行的锁文件路径。已有 cron 的 flock 保护时通常仍保持默认值。
# DAILY_RUN_LOCK_PATH=docs/.daily_run.lock

# 任务异常退出后锁的最长有效期（秒）。默认 6 小时；仅在正常任务确实超过 6 小时时调大。
# DAILY_RUN_LOCK_TTL_SECONDS=21600

# 是否采集 Hacker News 的 AI 社区讨论；1 开启，0 关闭。排查某个来源时可临时关闭。
# ENABLE_HN_COLLECTOR=1

# 获取 Hacker News 条目详情的总超时秒数。网络异常时可降低以更快完成任务。
# HN_DETAILS_TIMEOUT=90

# 是否采集 GitHub 热门 AI 开源项目；1 开启，0 关闭。
# ENABLE_GITHUB_COLLECTOR=1

# 是否采集 Hugging Face 的近期热门模型；1 开启，0 关闭。
# ENABLE_HF_COLLECTOR=1

# 是否采集 arXiv 的近期 AI 论文；1 开启，0 关闭。
# ENABLE_ARXIV_COLLECTOR=1

# GitHub API 令牌（可选）。配置后可提高请求限额并减少 GitHub 来源被限流跳过的概率。
# GITHUB_TOKEN=

# Hugging Face API 令牌（可选）。通常无需填写；遇到限流或需要热门榜单降级查询时再配置。
# HF_TOKEN=

# 是否启用 LLM 发布前质检；关闭后不运行证据核查和高风险条目回填，通常应保持 1。
# ENABLE_LLM_QUALITY_GATE=1

# 旧版兼容开关，当前不会再阻断整天草稿创建。保持 0，无需为生产环境开启。
# QUALITY_GATE_STRICT=0

# 是否移除质检标记为高风险的单条新闻，并使用候选池中的合格条目回填。
# 生产环境建议保持 1；设为 0 可能保留证据不足的内容。
# ENABLE_PUBLISH_SAFETY_FILTER=1

# 安全替补条目数量下限；候选池较小时用于确保有足够条目可回填。
# DAILY_SAFETY_RESERVE_N=6

# 质量审核 LLM 的单次请求超时秒数。未设置时为 45 秒，以容纳多候选批量审查。
# QUALITY_GATE_TIMEOUT=15

# 质量审核 LLM 单次返回的最大 token 数。审核结果被截断时可适度增大。
# QUALITY_GATE_MAX_TOKENS=4000

# 是否下载新闻原文中的可信配图，用于日报和微信正文；1 开启，0 使用纯文字卡片。
# 图片来源不稳定或任务耗时过长时，可临时设为 0 排查。
# ENABLE_ARTICLE_IMAGE_FETCH=1

# 下载、解码和校验单张原文图片的超时秒数。网络慢时可增大，过大将拖慢任务。
# ARTICLE_IMAGE_TIMEOUT=8

# 没有可信原文图时，是否请求图片模型生成封面；0 则直接使用本地无字封面。
# 没有稳定的图片 API 或希望零额外成本时设为 0。
# ENABLE_AI_COVER_GENERATION=1

# AI 封面疑似包含错误文字、Logo 等质量问题时，是否改用本地无字封面。
# 生产环境建议保持 1；设为 0 会保留可疑的 AI 图片。
# FORCE_LOCAL_COVER_ON_BAD_IMAGE=1

# 图片服务遇到超时、429 或 5xx 时的最大尝试次数（包含首次请求）。
# 图片服务稳定时无需调大；调大可能显著延长日报任务。
# AI_COVER_MAX_RETRIES=5

# 单次图片生成 API 请求的硬超时秒数。慢模型可适度增大，过大将延后降级封面生成。
# IMAGE_GENERATION_TIMEOUT=30

# 是否跳过微信公众号草稿 API 调用；1 仍生成日报文件，仅用于本地或 CI 空跑。
# 生产定时任务必须保持 0，才能创建当天草稿。
# SKIP_WECHAT_DRAFT=0

# 日志目录；会写入 ai-news.log 和 error.log。Docker 默认使用 logs，无需修改。
# LOG_DIR=logs
