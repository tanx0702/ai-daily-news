# 可选配置参考
#
# 不要用此文件覆盖 .env。下面的变量均已注释，不会意外改变当前部署。
# 仅将需要的配置复制到 .env，然后重新创建 Docker 容器。
#
# 推荐使用 LLM_* 和 IMAGE_*。旧部署仍兼容 AGNES_*、OPENAI_* 别名，
# 但新部署不应继续使用这些别名。
# 布尔值使用 1（开启）或 0（关闭）。未复制到 .env 时采用程序默认值。

# 独立的质量审核模型：可选地增强事实简报的证据核验。
# 仅当想让核验使用不同于摘要的模型、密钥或服务商时才填写；留空会继承 LLM_*。
# 模型不可用或响应无效时，严格退回确定性的 rules_only，不会要求人工复核或让 LLM 修正事实。
# QUALITY_LLM_API_KEY=
# QUALITY_LLM_MODEL=
# QUALITY_LLM_API_BASE=

# 仅本地调试：当 WECHAT_TOKEN 未配置时跳过微信回调签名验证。
# 生产服务器必须保持 0，否则任何请求都可能伪造微信回调。
# ALLOW_INSECURE_WECHAT_TOKEN=0

# 微信草稿标题前缀，实际标题格式为“前缀｜月日”。仅需更换栏目名称时修改。
# WECHAT_DRAFT_TITLE_PREFIX=今日要闻

# 微信草稿的作者署名。仅需更换公众号展示署名时修改。
# WECHAT_DRAFT_AUTHOR=要闻编辑室

# Flask 微信回调读取的 latest.json 路径。Docker 默认挂载路径正确，通常不需要修改。
# NEWS_DATA_FILE=/app/docs/latest.json

# 仅直接执行“python app.py”时使用的 Flask 端口；Docker 的 Gunicorn 不读取此项。
# PORT=5000

# 日报日期和“今天”判定所用时区。服务器不在中国时仍应保持 Asia/Shanghai。
# APP_TIMEZONE=Asia/Shanghai

# 仅服务器需要可靠外网时启用 Docker 内部 egress-proxy profile。代理没有宿主机端口，
# web 仅在同时设置下面两个 *_PROXY 变量时才经由 proxy:7890 出网。
# COMPOSE_PROFILES=egress-proxy
# AI_NEWS_HTTP_PROXY=http://proxy:7890
# AI_NEWS_HTTPS_PROXY=http://proxy:7890
# AI_NEWS_NO_PROXY=localhost,127.0.0.1,web,nginx,proxy
# AI_NEWS_PROXY_BINARY_PATH=/root/ai-news-proxy/bin/sing-box
# AI_NEWS_PROXY_CONFIG_PATH=/root/ai-news-proxy/config.json
# 私有 config.json 由 scripts/generate_sing_box_config.py 从单个 VLESS WebSocket + TLS 或 TCP + Reality 节点生成；
# 不要把订阅链接、节点链接、私有配置或二进制复制到 .env、仓库、日志或 docs/。

# 每天最终展示的唯一 AI 事实简报上限。有效配置为 5-15，5-14 条是正常短版。
# DAILY_TOP_N=15

# 日报可创建草稿所需的最少唯一事实简报；少于该值会 block，不会伪造回填。
# DAILY_MIN_ITEMS=5

# 进入事件聚类的候选池总量。先聚类再生成简报；歧义重复项会隔离，不能用于回填。
# DAILY_CANDIDATE_POOL_N=45

# 同一来源在候选排序中的偏好上限，不是最终草稿的来源占比阻断规则。
# DAILY_MAX_ITEMS_PER_SOURCE=2

# 同一主题在候选排序中的偏好上限；最终去重依赖事件聚类和隔离规则。
# DAILY_MAX_ITEMS_PER_TOPIC=2

# 候选排序时优先保留官方或研究来源的数量；不替代每条简报的规范证据绑定。
# DAILY_MIN_PRIMARY_OR_RESEARCH=2

# 跨来源语义事件去重的发布时间窗口（小时）。窗口外即使主体和动作相似也按独立事件处理。
# SEMANTIC_DEDUP_WINDOW_HOURS=48

# 单期聚类和发布前去重共享的质量 LLM 调用预算。0 表示只使用确定性规则和保守隔离。
# SEMANTIC_DEDUP_MAX_LLM_CALLS=20

# 语义重复复核的单次超时秒数；未配置时继承 QUALITY_GATE_TIMEOUT，默认 45 秒。
# SEMANTIC_DEDUP_TIMEOUT=45

# 单个 RSS 源或采集请求的超时秒数。网络慢时可增大；过大将拖慢整次任务。
# DAILY_RSS_TIMEOUT=30

# 文本 LLM 的单次摘要请求超时秒数。模型响应较慢时可增大；超时会降级保留原文信息。
# DAILY_LLM_TIMEOUT=90

# 新闻发布时间的回溯窗口（小时）。增大可补足新闻较少的日子，但会降低“当天”的新鲜度。
# DAILY_NEWS_HOURS=36

# 是否接纳没有发布日期的条目；0 会过滤，1 可提高数量但可能混入旧内容。
# DAILY_ALLOW_UNDATED=0

# 防止两个日报任务并发执行的锁文件路径。已有 cron 的 flock 保护时通常仍保持默认值。
# DAILY_RUN_LOCK_PATH=docs/.daily_run.lock

# 任务异常退出后锁的最长有效期（秒）。默认 6 小时；仅在正常任务确实超过 6 小时时调大。
# DAILY_RUN_LOCK_TTL_SECONDS=21600

# 是否采集 Hacker News 的 AI 社区讨论；1 开启，0 关闭。排查某个来源时可临时关闭。
# ENABLE_HN_COLLECTOR=1

# 获取 Hacker News 条目详情的总超时秒数。网络异常时可降低以更快完成任务。
# HN_DETAILS_TIMEOUT=90

# 是否采集 GitHub 热门 AI 开源项目；1 开启，0 关闭。
# ENABLE_GITHUB_COLLECTOR=1

# 是否采集 Hugging Face 的近期热门模型；1 开启，0 关闭。
# ENABLE_HF_COLLECTOR=1

# 是否采集 arXiv 的近期 AI 论文；1 开启，0 关闭。
# ENABLE_ARXIV_COLLECTOR=1

# 是否读取 GitHub Runner 发布的公开 X 信息源快照；1 开启，0 时保持 RSS 等既有来源。
# ENABLE_X_COLLECTOR=1

# 公开 X 快照地址。默认值指向仓库 x-feed 数据分支，一般无需配置。
# X_FEED_URL=https://raw.githubusercontent.com/tanx0702/ai-daily-news/x-feed/x-feed.json

# 接受的 X 快照最大时效（小时）。超过时效或快照读取失败会自动跳过 X，不影响日报。
# X_FEED_MAX_AGE_HOURS=6

# 每期日报可入选的 X 条目上限；该上限在候选不足时也不会放宽。
# DAILY_X_MAX_ITEMS=5

# X 规范来源的软目标；达到前优先尝试 X 候选，但所有条目仍须通过完整质检，不能硬凑。
# 取值必须在 0 到 DAILY_X_MAX_ITEMS 之间；未设置时默认为 min(3, DAILY_X_MAX_ITEMS)。
# DAILY_X_TARGET_ITEMS=3

# GitHub API 令牌（可选）。配置后可提高请求限额并减少 GitHub 来源被限流跳过的概率。
# GITHUB_TOKEN=

# Hugging Face API 令牌（可选）。通常无需填写；遇到限流或需要热门榜单降级查询时再配置。
# HF_TOKEN=

# 质量审核 LLM 的单次请求超时秒数。不可用、超时或响应无效都会严格使用 rules_only。
# QUALITY_GATE_TIMEOUT=45

# 是否下载新闻原文中的可信配图，用于日报和微信正文；1 开启，0 使用纯文字卡片。
# 图片来源不稳定或任务耗时过长时，可临时设为 0 排查。
# ENABLE_ARTICLE_IMAGE_FETCH=1

# 下载、解码和校验单张原文图片的超时秒数。网络慢时可增大，过大将拖慢任务。
# ARTICLE_IMAGE_TIMEOUT=8

# 没有可信原文图时，是否请求图片模型生成封面；0 则直接使用本地无字封面。
# 没有稳定的图片 API 或希望零额外成本时设为 0。
# ENABLE_AI_COVER_GENERATION=1

# Cover renderer: legacy keeps v1 source-image/AI/fallback behavior; editorial uses the local deterministic template.
# COVER_RENDER_MODE=editorial

# AI 封面疑似包含错误文字、Logo 等质量问题时，是否改用本地无字封面。
# 生产环境建议保持 1；设为 0 会保留可疑的 AI 图片。
# FORCE_LOCAL_COVER_ON_BAD_IMAGE=1

# 图片服务遇到超时、429 或 5xx 时的最大尝试次数（包含首次请求）。
# 图片服务稳定时无需调大；调大可能显著延长日报任务。
# AI_COVER_MAX_RETRIES=5

# 单次图片生成 API 请求的硬超时秒数。慢模型可适度增大，过大将延后降级封面生成。
# IMAGE_GENERATION_TIMEOUT=30

# 唯一安全的干跑边界；设为 1 时仍生成日报与 latest.json，但绝不调用微信草稿 API。
# 被 block 或草稿执行失败的运行仍返回非零状态；生产定时任务保持 0。
# SKIP_WECHAT_DRAFT=0

# 日志目录；会写入 ai-news.log 和 error.log。Docker 默认使用 logs，无需修改。
# LOG_DIR=logs

# Private browser review for saved shadow editorial runs. Configure both values
# in .env to enable /editorial-review; leave either blank to keep it hidden.
# EDITORIAL_REVIEW_USERNAME=
# EDITORIAL_REVIEW_PASSWORD=
